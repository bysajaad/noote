{
  "name": "noote",
  "displayName": "Noote — Markdown Slash Commands",
  "description": "Notion-style slash commands, snippets, and smart list continuation for Markdown files in VS Code.",
  "version": "0.0.4",
  "publisher": "bysajaad",
  "license": "MIT",
  "icon": "assets/icon.png",
  "homepage": "https://noote.iamsajaad.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/bysajaad/noote.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "markdown",
    "markdown editor",
    "markdown snippets",
    "markdown slash commands",
    "slash commands",
    "notion",
    "notion style",
    "outline",
    "notes",
    "note taking",
    "gfm",
    "github flavored markdown",
    "todo",
    "checkbox",
    "table",
    "headings"
  ],
  "activationEvents": [
    "onLanguage:markdown"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Noote",
      "properties": {
        "mdSlash.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the '/' slash command menu in markdown files."
        },
        "mdSlash.disabledCommands": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Command labels to hide from the slash command menu."
        },
        "mdSlash.customSnippets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "aliases": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "snippet": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "snippet"
            ]
          },
          "default": [],
          "description": "User-defined commands merged into the slash command menu."
        }
      }
    },
    "keybindings": [
      {
        "command": "noote.onEnterKey",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == markdown && !editorReadonly && !editorHasSelection && !suggestWidgetVisible && !inSnippetMode"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "compile-tests": "tsc -p ./",
    "watch-tests": "tsc -p ./ -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "test": "npm run test:unit && node ./out/test/runTest.js",
    "vscode:prepublish": "npm run package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "glob": "^10.4.5",
    "mocha": "^10.6.0",
    "typescript": "^5.5.3"
  }
}
